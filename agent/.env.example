# Get this from the Rakshak dashboard: Agent pairing > Pair this device
AGENT_TOKEN=

# Explicit user authorization to monitor this host (processes, network sockets, logs)
DEVICE_ACCESS_GRANTED=true

BACKEND_URL=http://localhost:5050

# Collector poll intervals (ms)
PROCESS_POLL_INTERVAL_MS=10000
NETWORK_POLL_INTERVAL_MS=15000

# How often findings are batched and sent, and how often a heartbeat
# goes out even with nothing new to report
BATCH_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=30000

# Bounded local buffer during a backend outage
MAX_BUFFERED_FINDINGS=500

# N failed logins from one IP within this many minutes = brute force
BRUTE_FORCE_WINDOW_MINUTES=10

# Findings sharing an entity within this many minutes get correlated
# into one incident
CORRELATION_WINDOW_MINUTES=10
